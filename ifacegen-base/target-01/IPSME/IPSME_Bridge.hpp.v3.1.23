
#pragma once

#include <cassert>
#include <cstdio>
#include <memory>
#include <mutex>
#include <stdexcept>
#include <string>

#include <nlohmann/json.hpp>

// #include "IPSME_MsgEnv.h"
#include "../cpp-json-msg.git/json_msg+ack.h"

#include "../Interface_App.hpp"
#include "../cpp-EventLog.git/InMemory_EventLog_ext.hpp"   // IEvent (process_msgs static_pointer_cast) — pulls in the IEventLog interface

#include "Responder_Discovery.hpp"
#include "Responder_MessagingEnv.hpp"

class IPSME_Bridge {
public:
	static std::shared_ptr<IPSME_Bridge> get_instance(Interface_App * const kpi_App, IEventLog * const kp_IEventLog) {
		std::call_once(_init_flag, [&]() {
			_instance = std::shared_ptr<IPSME_Bridge>( new IPSME_Bridge(kpi_App, kp_IEventLog) );
		});
		return _instance;
	}

	static std::shared_ptr<IPSME_Bridge> get_instance() {
		if (! _instance)
			throw std::runtime_error("IPSME_Bridge has not been initialized yet.");
		return _instance;
	}

	static void destroy_instance() { _instance.reset(); }

	IPSME_Bridge(Interface_App * const kpi_App, IEventLog * const kp_IEventLog)
		:	_kpi_App(kpi_App),
			_uptr_IPSME( std::make_unique<IPSME_MsgEnv>() ),
			_kp_IEventLog(kp_IEventLog)
			, _responder_MessagingEnv(std::make_unique<Responder_MessagingEnv>(_uptr_IPSME.get(), kpi_App, kp_IEventLog))
			, _responder_Discovery(std::make_unique<Responder_Discovery>(_uptr_IPSME.get(), kpi_App, kp_IEventLog))
	{
		bool b_ret = _uptr_IPSME->subscribe(&_handler_static, NULL);
		assert(b_ret);
	}

	~IPSME_Bridge()	{ _uptr_IPSME->unsubscribe(&_handler_static); }

	IEventLog * const get_EventLog() const { return _kp_IEventLog; }
	IPSME_MsgEnv * const get_IPSME() const { return _uptr_IPSME.get(); }

	Responder_MessagingEnv * const protocol_MessagingEnv() const { return _responder_MessagingEnv.get(); }
	Responder_Discovery * const protocol_Discovery() const { return _responder_Discovery.get(); }

public:
	bool handler_json_ack(IPSME_MsgEnv::t_MSG msg, JSON::JSON_Ack json_ack)
	{
		if (_responder_MessagingEnv->handler_json_ack(msg, json_ack))
			return true;

		return false;
	}

	bool handler_json_eff(IPSME_MsgEnv::t_MSG msg, JSON::JSON_Eff json_eff)
	{
		if (JSON::JSON_Ack::validate(json_eff) && handler_json_ack(msg, json_eff))
			return true;

		if (_responder_Discovery->handler_json_eff(msg, json_eff))
			return true;

		return false;
	}

	bool handler_json_msg(IPSME_MsgEnv::t_MSG msg, JSON::JSON_Msg json_msg)
	{
		if (JSON::JSON_Eff::validate(json_msg) && handler_json_eff(msg, json_msg))
			return true;

		if (_responder_MessagingEnv->handler_json_msg(msg, json_msg))
			return true;

		if (_responder_Discovery->handler_json_msg(msg, json_msg))
			return true;

		return false;
	}

	bool handler_json(IPSME_MsgEnv::t_MSG msg, nlohmann::json json)
	{
		if (JSON::JSON_Msg::validate(json) && handler_json_msg(msg, json))
			return true;

		return false;
	}

	bool handler_string(IPSME_MsgEnv::t_MSG msg, std::string str_msg)
	{
		nlohmann::json json = nlohmann::json::parse(str_msg, nullptr, false);
		if (! json.is_discarded() && handler_json(msg, json))
			return true;

		// test strings here ...

		return false;
	}

	void handler(IPSME_MsgEnv::t_MSG msg, void*)
	{
		try {
			if (handler_string(msg, std::string(msg)))
				return;
		}
		catch (...) {
			printf("ERR: error in message execution\n");
			return;
		}

		// drop silently ...
	}

public:
	void process_msgs()
	{
		_uptr_IPSME->process_msgs();

		for (IEventLog::t_const_iterator it = get_EventLog()->q_begin(); it != get_EventLog()->q_end(); ++it)
		{
			IEventLog::t_idx _idx_evt_i = it->first;

			auto ptr_evt = std::static_pointer_cast<IEvent>(get_EventLog()->get_Event(_idx_evt_i));
			assert(ptr_evt);
			// printf("%s: i[%llu] [%s]\n", __func__, (unsigned long long)_idx_evt_i, ptr_evt->type.c_str());

			try {
				if (_responder_MessagingEnv->reprocess(ptr_evt))
					continue;

				if (_responder_Discovery->reprocess(ptr_evt))
					continue;
			}
			catch (...) {
				printf("process_msgs(): unknown exception\n");
			}
		}

		get_EventLog()->purge_dequeued();
	}

private:
	inline static std::once_flag _init_flag;
	inline static std::shared_ptr<IPSME_Bridge> _instance;

	Interface_App * const _kpi_App;
	std::unique_ptr<IPSME_MsgEnv> _uptr_IPSME;
	IEventLog * const _kp_IEventLog;

	std::unique_ptr<Responder_MessagingEnv> _responder_MessagingEnv;
	std::unique_ptr<Responder_Discovery> _responder_Discovery;

	// this is the reason IPSME_Bridge is a singleton
	static void _handler_static(const char* psz_msg, void* p_void) {
		auto bridge = IPSME_Bridge::get_instance();
		bridge->handler(psz_msg, p_void);
	}
};
